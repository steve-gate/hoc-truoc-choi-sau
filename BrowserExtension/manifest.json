{
  "manifest_version": 3,
  "name": "FocusLock Browser Bridge",
  "version": "7.8.0.2",
  "description": "FocusLock V7.8.0.2 OneDir: browser accounting + Profile policies + cooldown.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "FocusLock Browser Bridge",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}