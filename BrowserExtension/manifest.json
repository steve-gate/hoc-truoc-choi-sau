{
  "manifest_version": 3,
  "name": "FocusLock Browser Bridge",
  "version": "5.0.0",
  "description": "Phân loại tab Chrome/Edge thành Focus hoặc Giải trí và kết nối với FocusLock Guard.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FocusLock Browser Bridge",
    "default_popup": "popup.html"
  }
}
