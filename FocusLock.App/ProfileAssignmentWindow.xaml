<Window x:Class="FocusLock.App.ProfileAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusLock — Chọn Block Profile" Width="520" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"/><TextBlock Text="Website sẽ dùng toàn bộ chính sách, allowance và lịch của profile đã chọn." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Block Profile" FontWeight="Bold"/><ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" Margin="0,10,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Hủy" Click="Cancel_Click" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Content="Lưu" Click="Save_Click" MinWidth="100"/></StackPanel>
    </Grid>
</Window>
