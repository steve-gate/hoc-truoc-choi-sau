<Window x:Class="FocusLock.App.WeeklyScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusLock — Lịch khóa tuần"
        Width="1080" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lịch khóa hàng tuần" FontSize="26" FontWeight="Bold" Foreground="#10203A"/>
                <TextBlock x:Name="ProfileText" Margin="0,5,0,0" Foreground="#667085" FontSize="13"/>
                <TextBlock Text="Kéo chuột để tô thời gian. Mỗi ô = 30 phút. Ô tối là thời gian được chọn." Margin="0,4,0,0" Foreground="#8A94A6" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="T2–T6 22:00–24:00" Click="PresetWeekNights_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Xóa lịch" Click="Clear_Click" Padding="12,7"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9E1EC" BorderThickness="1" CornerRadius="14" Padding="12">
            <ScrollViewer x:Name="ScheduleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ScheduleGrid" Background="White"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="EnabledCheck" Content="Bật lịch này" VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryText" Margin="14,0,0,0" Foreground="#667085" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Đóng không lưu" Click="Cancel_Click" Padding="18,9" Margin="0,0,10,0"/>
                <Button Content="Lưu lịch" Click="Save_Click" Padding="22,9" Background="#5B61F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
