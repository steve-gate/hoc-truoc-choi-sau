                                <Border Width="70" Height="70" CornerRadius="22" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center"><TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="Học trước. Chơi sau." FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                <TextBlock Text="FocusLock biến thời gian tập trung thật thành thời gian giải trí. Thiết lập mất khoảng một phút." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OnboardingStep1" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Bạn dùng ứng dụng nào để học hoặc làm việc?" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Chọn ít nhất một ứng dụng. FocusLock chỉ cộng thời gian khi bạn đang thực sự dùng nó." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource FocusButton}" Content="Chọn từ ứng dụng đang chạy" Click="AddRunningFocusApp_Click" Margin="0,0,10,0"/><Button Content="Chọn file .exe" Click="AddFocusApp_Click"/></StackPanel>
                                <Border Background="{StaticResource FocusSoftBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><TextBlock x:Name="OnboardingFocusCountText" Text="0 ứng dụng học tập đã chọn" Foreground="{StaticResource FocusBrush}" FontWeight="SemiBold"/></Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OnboardingStep2" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ứng dụng nào là giải trí?" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Game, mạng xã hội hoặc ứng dụng bạn muốn giới hạn thời gian." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PlayButton}" Content="Chọn từ ứng dụng đang chạy" Click="AddRunningEntertainmentApp_Click" Margin="0,0,10,0"/><Button Content="Chọn file .exe" Click="AddEntertainmentApp_Click"/></StackPanel>
                                <Border Background="{StaticResource PlaySoftBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><TextBlock x:Name="OnboardingEntertainmentCountText" Text="0 ứng dụng giải trí đã chọn" Foreground="{StaticResource PlayBrush}" FontWeight="SemiBold"/></Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OnboardingStep3" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Chọn tỷ lệ học → chơi" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Bạn có thể đổi lại bất cứ lúc nào trong Cài đặt." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,20"/>
                                <Grid MaxWidth="500" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="70"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SmallCardStyle}" Background="{StaticResource FocusSoftBrush}" BorderBrush="#CEE4FF"><StackPanel><TextBlock Text="Tập trung" Foreground="{StaticResource FocusBrush}" FontWeight="SemiBold"/><DockPanel Margin="0,9,0,0"><TextBox x:Name="OnboardingFocusMinutesBox" Text="30" Width="90"/><TextBlock Text="phút" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
                                    <TextBlock Grid.Column="1" Text="→" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <Border Grid.Column="2" Style="{StaticResource SmallCardStyle}" Background="{StaticResource PlaySoftBrush}" BorderBrush="#FFE0CC"><StackPanel><TextBlock Text="Giải trí" Foreground="{StaticResource PlayBrush}" FontWeight="SemiBold"/><DockPanel Margin="0,9,0,0"><TextBox x:Name="OnboardingRewardMinutesBox" Text="10" Width="90"/><TextBlock Text="phút" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingBackButton" Content="← Quay lại" Click="OnboardingBack_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
                        <Button x:Name="OnboardingNextButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Bắt đầu →" Click="OnboardingNext_Click" MinWidth="130"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
