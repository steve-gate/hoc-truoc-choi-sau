                <!-- STATISTICS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="StatsPeriodLabel" Text="Tuần này" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Nhìn tiến độ, không nhìn quá nhiều chi tiết kỹ thuật." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="StatsPeriodCombo" DockPanel.Dock="Right" Width="150" HorizontalAlignment="Right" SelectedIndex="1" SelectionChanged="StatsPeriodCombo_SelectionChanged"><ComboBoxItem Content="Hôm nay" Tag="today"/><ComboBoxItem Content="Tuần này" Tag="week"/><ComboBoxItem Content="Tháng này" Tag="month"/></ComboBox>
                            </DockPanel>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SmallCardStyle}" Margin="0,0,5,0"><StackPanel><TextBlock Text="TẬP TRUNG" Foreground="{StaticResource FocusBrush}" FontWeight="SemiBold"/><TextBlock x:Name="StatsFocusText" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="StatsFocusPercentText" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource SmallCardStyle}" Margin="3,0"><StackPanel><TextBlock Text="GIẢI TRÍ" Foreground="{StaticResource PlayBrush}" FontWeight="SemiBold"/><TextBlock x:Name="StatsPlayText" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="StatsPlayPercentText" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
