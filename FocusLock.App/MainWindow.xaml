                                                    <Button Style="{StaticResource FocusButton}" Content="25 phút" Tag="25" Click="StartFocusSessionPreset_Click" Margin="0,0,7,0"/>
                                                    <Button Style="{StaticResource FocusButton}" Content="50 phút" Tag="50" Click="StartFocusSessionPreset_Click" Margin="0,0,7,0"/>
