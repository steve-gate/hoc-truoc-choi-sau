                                            <Button x:Name="EnableStrictButton" Style="{StaticResource PrimaryButton}" Content="Bật Strict" Click="EnableStrict_Click" Margin="0,0,6,6"/>
                                            <Button x:Name="RequestStrictUnlockButton" Content="Yêu cầu mở" Click="RequestStrictUnlock_Click" Margin="0,0,6,6"/>
                                            <Button x:Name="DisableStrictButton" Content="Tắt Strict" Click="DisableStrict_Click" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
