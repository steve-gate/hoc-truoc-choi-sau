                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="FocusSessionRewardText"
                                                   DockPanel.Dock="Right"
                                                   Text="Hoàn thành sẽ tạo key thưởng"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <Separator Margin="0,14,0,12" Background="{StaticResource BorderBrush}"/>

                                    <StackPanel x:Name="FocusSessionStartPanel">
                                        <TextBlock Text="Nguồn Focus / công thức thưởng của phiên" Style="{StaticResource LabelText}"/>
                                        <ComboBox x:Name="FocusSessionProfileCombo"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="FocusSessionProfileCombo_SelectionChanged"
                                                  Margin="0,5,0,10"
                                                  MaxWidth="620"
                                                  HorizontalAlignment="Left"
                                                  MinWidth="390"/>

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Bắt đầu nhanh" Style="{StaticResource LabelText}"/>
