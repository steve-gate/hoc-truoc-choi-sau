<Window x:Class="FocusLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusLock — Học trước · chơi sau"
        Width="1240" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,24">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="FL" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,1,0,0">
                        <TextBlock Text="FocusLock" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Học trước · chơi sau" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                        <TextBlock Text="V7.7.9" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" IsChecked="True" Tag="0" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="28"/><TextBlock Text="Trang chủ" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="1" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="17" Width="28"/><TextBlock Text="Ứng dụng" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavWeb" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="2" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="18" Width="28"/><TextBlock Text="Website" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRewards" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="3" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="★" FontSize="17" Width="28"/><TextBlock Text="Phần thưởng" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStats" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="4" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="17" Width="28"/><TextBlock Text="Thống kê" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavControl" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="5" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="17" Width="28"/><TextBlock Text="Kiểm soát" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadioStyle}" GroupName="Navigation" Tag="6" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="28"/><TextBlock Text="Cài đặt" VerticalAlignment="Center"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="13" Padding="12" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Bảo vệ nền" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock x:Name="SidebarStatusText" Text="Đang kiểm tra…" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="16,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="28,22,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="Trang chủ"/>
                    <TextBlock x:Name="PageSubtitleText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" Text="Tập trung đúng việc, rồi tận hưởng phần thưởng của bạn."/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServiceStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServiceStatusText" Text="Đang bảo vệ" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource HiddenTabControlStyle}" SelectedIndex="0">
                <!-- HOME -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource PillBorderStyle}" Background="{StaticResource FocusSoftBrush}">
                                                <TextBlock x:Name="CurrentStatusText" Text="Sẵn sàng" Foreground="{StaticResource FocusBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock x:Name="CurrentAppText" DockPanel.Dock="Right" Text="—" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                            <TextBlock Text="Phiên tập trung hiện tại" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FocusProgressText" Text="00:00 / 30:00" FontSize="38" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="HomeFocusRemainingText" Text="Còn 30 phút để nhận phần thưởng" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="FocusProgressBar" Grid.Row="2" Margin="0,18,0,0" Height="11"/>
                                        <DockPanel Grid.Row="3" Margin="0,13,0,0">
                                            <TextBlock Text="Mỗi phiên hoàn thành sẽ tạo một phần thưởng" Foreground="{StaticResource SubtleBrush}" FontSize="11.5"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Xem phần thưởng  →" Tag="3" Click="NavigateButton_Click"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PlaySoftBrush}" BorderBrush="#FFE0CC" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="Thời gian giải trí" Foreground="{StaticResource PlayBrush}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="🎮" FontSize="19"/></DockPanel>
                                            <TextBlock x:Name="EntertainmentText" Text="00:00" FontSize="34" FontWeight="Bold" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="LockStateText" Text="Đang khóa" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource SuccessSoftBrush}" BorderBrush="#CFEEDF" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel><TextBlock Text="Chuỗi tập trung" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="🔥" FontSize="19"/></DockPanel>
                                            <TextBlock x:Name="HomeStreakText" Text="0 ngày" FontSize="30" FontWeight="Bold" Margin="0,7,0,0"/>
                                            <TextBlock Text="Duy trì đều mỗi ngày" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SmallCardStyle}" Margin="0,0,6,0">
                                    <StackPanel><TextBlock Text="Hôm nay · Tập trung" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeTodayFocusText" Text="00:00" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Thời gian hợp lệ" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" Margin="0,3,0,0"/></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SmallCardStyle}" Margin="3,0">
                                    <StackPanel><TextBlock Text="Hôm nay · Giải trí" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeTodayPlayText" Text="00:00" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Đã sử dụng" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" Margin="0,3,0,0"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SmallCardStyle}" Margin="6,0,0,0">
                                    <StackPanel><TextBlock Text="Phần thưởng" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HomeRewardText" Text="0 khả dụng" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Mã chưa dùng và chưa hết hạn" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" Margin="0,3,0,0"/></StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thiết lập nhanh" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Thêm ứng dụng và website để FocusLock biết đâu là học, đâu là giải trí." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FocusButton}" Content="+ Ứng dụng học" Tag="1" Click="NavigateButton_Click" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="+ Website" Tag="2" Click="NavigateButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- APPLICATIONS -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Thêm ứng dụng" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="Nhanh nhất: chọn từ các ứng dụng đang chạy. Hoặc chọn trực tiếp file .exe." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FocusButton}" Content="Ứng dụng đang chạy" Click="AddRunningFocusApp_Click" Margin="0,0,8,0"/>
                                        <Button Content="Chọn file .exe" Click="AddFocusApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Block Profiles" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Mỗi Profile là một bộ luật hoàn chỉnh cho cả ứng dụng + website: thành viên, ví/allowance, lịch tuần và cách khóa. Quản lý tập trung thay vì chỉnh từng mục rời rạc." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Mở Profile Center" Click="OpenProfileCenter_Click" Margin="0,0,10,0"/>
                                            <TextBox x:Name="NewBlockProfileNameBox" Width="150" Visibility="Collapsed" MinHeight="34" ToolTip="Ví dụ: Game, Mạng xã hội, Video"/>
                                            <ComboBox x:Name="NewBlockProfileModeCombo" Width="190" Visibility="Collapsed" Margin="8,0,0,0" SelectedIndex="0" ToolTip="Chính sách ngoài lịch ban đầu">
                                                <ComboBoxItem Content="Chỉ dùng ví Focus" Tag="EarnedTime"/>
                                                <ComboBoxItem Content="Allowance → ví Focus" Tag="AllowanceThenEarned"/>
                                                <ComboBoxItem Content="Dùng tự do" Tag="Free"/>
                                            </ComboBox>
                                            <Button Style="{StaticResource PrimaryButton}" Content="+ Profile" Click="AddBlockProfile_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#D9DDFE" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,12,0,0">
                                        <TextBlock Text="App giải trí không còn tự giữ policy riêng. Hãy đưa app + website vào Profile phù hợp; Profile sẽ quyết định allowance, ví, lịch và cách khóa." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <ItemsControl x:Name="BlockProfilesItems" Margin="0,12,0,0" Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="350" MinHeight="142" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,10,10">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                                                <TextBlock Text="{Binding MembershipSummary}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11.5" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding PolicySummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,3"/>
                                                        <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" FontSize="11"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                            <Button Style="{StaticResource PrimaryButton}" Content="Quản lý Profile" CommandParameter="{Binding Profile}" Click="EditBlockProfile_Click"/>
                                                            <Button Style="{StaticResource TextButton}" Content="Bật/Tắt" CommandParameter="{Binding Profile}" Click="ToggleBlockProfile_Click" Margin="6,0,0,0"/>
                                                            <Button Style="{StaticResource TextButton}" Content="Xóa" Foreground="{StaticResource DangerBrush}" CommandParameter="{Binding Profile}" Click="RemoveBlockProfile_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Học tập &amp; Làm việc" Style="{StaticResource SectionTitle}"/><TextBlock Text="Thời gian hợp lệ được cộng vào Focus." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource FocusButton}" Content="+ Thêm" Click="AddRunningFocusApp_Click" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ListBox x:Name="FocusAppsList" BorderThickness="0" Background="Transparent" MaxHeight="500" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource FocusSoftBrush}"><TextBlock Text="▣" Foreground="{StaticResource FocusBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/><TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0"/><TextBlock Text="{Binding BlockProfileLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource TextButton}" Content="Bật/Tắt" CommandParameter="{Binding}" Click="ToggleAppCard_Click"/><Button Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}" Content="Xóa" CommandParameter="{Binding}" Click="RemoveAppCard_Click"/></StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="FocusAppsEmptyText" Text="Chưa có ứng dụng học tập. Bấm “+ Thêm” để bắt đầu." Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Giải trí" Style="{StaticResource SectionTitle}"/><TextBlock Text="App giải trí được quản lý bởi Profile. Mọi policy, allowance, lịch và cách khóa mặc định nằm trong Profile Center." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PlayButton}" Content="+ Thêm" Click="AddRunningEntertainmentApp_Click" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ListBox x:Name="EntertainmentAppsList" BorderThickness="0" Background="Transparent" MaxHeight="500" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PlaySoftBrush}"><TextBlock Text="▶" Foreground="{StaticResource PlayBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                                                <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="7,3"><TextBlock Text="{Binding BlockProfileLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
                                                                    <TextBlock Text=" · " Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding BlockActionPolicyLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                    <Button Style="{StaticResource TextButton}" Content="Nâng cao app" ToolTip="Chỉ dùng khi app này cần override cách khóa của Profile" CommandParameter="{Binding}" Click="EditAppPolicy_Click" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource TextButton}" Content="Bật/Tắt" CommandParameter="{Binding}" Click="ToggleAppCard_Click"/><Button Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}" Content="Xóa" CommandParameter="{Binding}" Click="RemoveAppCard_Click"/></StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="EntertainmentAppsEmptyText" Text="Chưa có ứng dụng giải trí. Bấm “+ Thêm” để chọn." Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- compatibility grid kept hidden for legacy handlers -->
                            <DataGrid x:Name="AppsGrid" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Visibility="Collapsed"><Button Click="AddEntertainmentApp_Click"/><Button Click="ToggleApp_Click"/><Button Click="RemoveApp_Click"/></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- WEBSITES -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Trang đang mở" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock x:Name="BrowserCurrentPageText" Text="Trang hiện tại: —" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BrowserCurrentUrlText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="BrowserCurrentRuleText" Text="Chưa có quy tắc" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="BrowserFocusSignalText" Text="Website Focus: đang chờ tín hiệu tab" Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,0" FontSize="11.5"/>
                                        <TextBlock x:Name="BrowserChargeStatusText" Text="Giải trí web: —" Foreground="{StaticResource PlayBrush}" Margin="0,4,0,0" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
