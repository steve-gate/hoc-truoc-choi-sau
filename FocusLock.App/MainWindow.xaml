                                            <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding MatchTypeLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10.8" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="{Binding Pattern}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BlockProfileLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource TextButton}" Content="Profile Center" ToolTip="Quản lý website theo Profile" Click="OpenProfileCenter_Click" Foreground="{StaticResource AccentBrush}"/><Button Style="{StaticResource TextButton}" Content="Bật/Tắt" CommandParameter="{Binding}" Click="ToggleBrowserRuleCard_Click"/><Button Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}" Content="Xóa" CommandParameter="{Binding}" Click="RemoveBrowserRuleCard_Click"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
