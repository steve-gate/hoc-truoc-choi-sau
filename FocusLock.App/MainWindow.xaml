                                        </ListBox>
                                        <TextBlock x:Name="BrowserFocusEmptyText" Text="Chưa có website học tập." Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="Website giải trí" Style="{StaticResource SectionTitle}"/><TextBlock Text="Website giải trí là thành viên của Profile. Quản lý thành viên, ví/allowance và lịch tập trung tại Profile Center." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>
