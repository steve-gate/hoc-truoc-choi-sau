                                <Border Grid.Column="3" Style="{StaticResource SmallCardStyle}" Margin="5,0,0,0"><StackPanel><TextBlock Text="CHUỖI" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/><TextBlock x:Name="StatsStreakText" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="StatsBestStreakText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="7 ngày gần nhất" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><ItemsControl x:Name="WeeklyChartItems"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DayLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Grid Grid.Column="1" Margin="8,0"><StackPanel><Border Height="10" Background="{StaticResource FocusSoftBrush}" CornerRadius="5"><Border Background="{StaticResource FocusBrush}" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding FocusBarWidth}"/></Border><Border Height="10" Background="{StaticResource PlaySoftBrush}" CornerRadius="5" Margin="0,4,0,0"><Border Background="{StaticResource PlayBrush}" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding PlayBarWidth}"/></Border></StackPanel></Grid><TextBlock Grid.Column="2" Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse Width="8" Height="8" Fill="{StaticResource FocusBrush}"/><TextBlock Text=" Focus" Foreground="{StaticResource MutedBrush}" Margin="3,0,14,0"/><Ellipse Width="8" Height="8" Fill="{StaticResource PlayBrush}"/><TextBlock Text=" Giải trí" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,0"/></StackPanel></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Ứng dụng dùng nhiều" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/><DataGrid x:Name="StatsAppsGrid" Height="300" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ứng dụng" Binding="{Binding AppName}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="Thời gian" Binding="{Binding Duration}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                            </Grid>
                            <Expander Header="Phiên gần đây" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="StatsSuspiciousText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,0,6"/><DataGrid x:Name="SessionsGrid" Height="250" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Ứng dụng" Binding="{Binding AppName}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding CategoryLabel}" Width="100"/><DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationLabel}" Width="100"/><DataGridTextColumn Header="Kết thúc vì" Binding="{Binding EndReason}" Width="180"/></DataGrid.Columns></DataGrid></StackPanel></Border></Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- CONTROL / STRICT BLOCKING V7.1 -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                            

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Focus Session — phiên tập trung có mục tiêu" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Phiên chỉ tiến khi FocusLock đang cộng Focus hợp lệ. Trong lúc chạy, app giải trí đã khai báo bị khóa và browser chỉ cho rule Học/Làm việc. Idle hoặc hoạt động không đủ sẽ tạm dừng tiến độ."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       MaxWidth="650"/>
                                        </StackPanel>
                                        <Button x:Name="AbandonFocusSessionButton"
                                                DockPanel.Dock="Right"
                                                Content="Bỏ phiên · không thưởng"
                                                Click="AbandonFocusSession_Click"
                                                IsEnabled="False"
                                                VerticalAlignment="Top"
                                                Margin="18,0,0,0"/>
