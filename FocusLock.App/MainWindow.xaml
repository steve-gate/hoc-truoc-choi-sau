                                    <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Phần thưởng khả dụng" Style="{StaticResource SectionTitle}"/><TextBlock Text="Bấm “Sử dụng” — mỗi key dùng một lần và luôn có hạn tối thiểu 24 giờ." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="ActiveRewardCountText" DockPanel.Dock="Right" Text="0 phần thưởng" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
                                    <ItemsControl x:Name="ActiveRewardItems">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="★" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/></Border><StackPanel Grid.Column="1" Margin="11,0"><TextBlock Text="{Binding RewardLabel}" FontWeight="Bold" FontSize="15"/><TextBlock Text="{Binding Code}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="{Binding RemainingLabel}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="11.5"/><TextBlock Text="{Binding ExpiresLocalLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Sử dụng" CommandParameter="{Binding}" Click="RedeemKeyCard_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoRewardsText" Text="Chưa có phần thưởng nào. Hãy hoàn thành một phiên Focus trước." Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Expander Header="Nhập mã thủ công / xem lịch sử" Foreground="{StaticResource MutedBrush}">
                                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12"><TextBox x:Name="RedeemKeyTextBox" MinWidth="280" CharacterCasing="Upper"/><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Sử dụng mã" Click="RedeemKey_Click" Margin="10,0,0,0"/><TextBlock x:Name="RedeemResultText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/></DockPanel>
                                        <DataGrid x:Name="KeysGrid" Height="260" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="Thưởng" Binding="{Binding RewardLabel}" Width="90"/><DataGridTextColumn Header="Hết hạn lúc" Binding="{Binding ExpiresLocalLabel}" Width="190"/><DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingLabel}" Width="150"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid>
                                    </StackPanel>
                                </Border>
