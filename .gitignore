## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# JetBrains Rider
.idea/
*.sln.iml

# FocusLock specific
publish/
.tools/
.build-*/
*.zip
*.log
guard-diagnostic.txt
web-diagnostic.txt
install.log
service-console.stderr.txt
service-console.stdout.txt

# Backups and temporary data
.onedir-data-preserve/
.runtime-backups/
.source-backups/

# Build outputs / payloads
FocusLock-OneDir/
payload/

# One-off test, validation notes and patches
*.patch
HOTFIX_*.txt
STATIC_VALIDATION_*.txt
TEST_*.txt
